# RootHide rootfs-layout DEB package profile.
#
# This file defines package layout/metadata only. It does NOT claim that the
# app binary is RootHide-native, signed, entitled, installable, or verified
# on a device. Static ldid validation (see sign-app-ldid.sh) proves only the
# signature structure, CDHash extraction and embedded-entitlement equality.
# Device installation, cold launch and post-reboot launch remain required
# acceptance tests.

DEB_PROFILE_ID="roothide-rootfs"

# Debian package identity and manager-side architecture. The architecture
# label is package-manager metadata; the app Mach-O slice is validated
# separately by package-deb.sh and is not forced to arm64e.
DEB_PACKAGE_ID="cn.yfen.filterkit"
DEB_PACKAGE_ARCH="iphoneos-arm64e"

# Rootfs-relative payload layout. The bundle installs under /Applications,
# not under a /var/jb Rootless prefix.
DEB_PAYLOAD_RELATIVE_PATH="Applications/FilterKit.app"
DEB_PAYLOAD_BUNDLE_NAME="FilterKit.app"
DEB_REGISTER_PATH="/Applications/FilterKit.app"

# control metadata.
DEB_MAINTAINER="FilterKit Project"
DEB_SECTION="Utilities"
DEB_PRIORITY="optional"
DEB_DEPENDS="firmware (>= 15.0), ellekit"
DEB_DESCRIPTION="RootHide and ElleKit plugin manager"
