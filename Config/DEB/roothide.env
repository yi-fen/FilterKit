# FilterKit RootHide DEB packaging profile.
# This profile defines package layout/metadata only; it does not claim that the
# app binary is RootHide-native, signed, entitled, installable, or device-verified.
DEB_PROFILE_ID="roothide-rootfs"
DEB_PACKAGE_ARCH="iphoneos-arm64e"
DEB_PAYLOAD_RELATIVE_PATH="Applications/FilterKit.app"
DEB_REQUIRED_DEPENDS_PATTERN="firmware"
DEB_REQUIRE_ROOT_OWNER_GROUP="1"
DEB_MINIMUM_BINARY_ARCH="arm64"
DEB_INSTALL_REGISTER_PATH="/Applications/FilterKit.app"
